# Object Storage (S3-compatible API)
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_OFFERS_KEY=offers.json
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Optional: required for Cloudflare R2 and other S3-compatible providers
OBJECT_STORAGE_ENDPOINT=

# TradeTracker Affiliate Webservice (SOAP). Never commit real values.
# Place secrets only in gitignored .env.local
TRADETRACKER_CUSTOMER_ID=
TRADETRACKER_ACCESS_KEY=
# Optional
# TRADETRACKER_LOCALE=nl_BE
# TRADETRACKER_SANDBOX=false
# TRADETRACKER_DEMO=false
# VacationWeb affiliate sites (default when unset = NL 512226)
# 512226 = VacationWeb.nl · 512055 = VacationWeb.be
# Keep BE and NL contexts separated.
# TRADETRACKER_AFFILIATE_SITE_ID=512226

# AN-064 Live Pricing Ops Cockpit (owner-only)
# Required in production. Development allows open access when unset.
# LIVE_PRICING_OPS_TOKEN=
# ADMIN_OPS_TOKEN=

# Shared L2 live-price store (Cloudflare R2) — AN-076
# Code default OFF when unset. Production/preview: set true (Vercel env).
# When true, overlays write-through to R2 prefix live-price/v1/
# and Results hydrates L2→L1 before provider work.
# LIVE_PRICE_L2_ENABLED=true

# Homepage → Results live-price prefetch bridge — AN-077
# Code default OFF when unset. Production/preview: set true (Vercel env).
# When true, definitive homepage search context schedules the
# existing production workset live-pricing flow in the background (non-blocking).
# HOME_LIVE_PRICE_PREFETCH_ENABLED=true
# Optional future alert channels (NOT live until provider wired):
# OPS_ALERT_EMAIL_TO=
# OPS_ALERT_EMAIL_PROVIDER=
# OPS_ALERT_SMS_TO=
# OPS_ALERT_SMS_PROVIDER=
# OPS_ALERT_WHATSAPP_TO=
# OPS_ALERT_WHATSAPP_TOKEN=
# OPS_ALERT_WHATSAPP_PHONE_ID=
# OPS_ALERT_VAPID_PUBLIC_KEY=
# OPS_ALERT_VAPID_PRIVATE_KEY=
