# Object Storage (S3-compatible API)
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_OFFERS_KEY=offers.json
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Optional: required for Cloudflare R2 and other S3-compatible providers
OBJECT_STORAGE_ENDPOINT=

# TradeTracker Affiliate Webservice (SOAP). Never commit real values.
# Place secrets only in gitignored .env.local
TRADETRACKER_CUSTOMER_ID=
TRADETRACKER_ACCESS_KEY=
# Optional
# TRADETRACKER_LOCALE=nl_BE
# TRADETRACKER_SANDBOX=false
# TRADETRACKER_DEMO=false
# VacationWeb affiliate sites (default when unset = NL 512226)
# 512226 = VacationWeb.nl · 512055 = VacationWeb.be
# Keep BE and NL contexts separated.
# TRADETRACKER_AFFILIATE_SITE_ID=512226
