{
  "manifestVersion": 1,
  "description": "Declarative inventory of TradeTracker feeds for VacationWeb. Consumed by lib/feeds/feed-registry.ts and scripts/import-all-feeds.ts (TD-015 refresh: npm run refresh:offers).",
  "fieldDocs": {
    "id": "Stable unique feed identifier used by future discovery/queue logic.",
    "provider": "Display/provider name matching runtime StoredOffer.provider (e.g. Corendon, Prijsvrij, Sunweb).",
    "profile": "Importer profile key that maps XML fields to StoredOffer (corendon | prijsvrij | sunweb).",
    "format": "Feed payload format (currently tradetracker-xml for all active feeds).",
    "enabled": "Whether this feed is intended for import when a registry-driven pipeline exists. Does not affect today's scripts.",
    "source.type": "How the feed is located today: file = single local path; future: url | glob.",
    "source.path": "Project-relative path to the local XML file (current manual drop location).",
    "campaignId": "TradeTracker campaign ID observed in the feed XML (optional metadata).",
    "preferredFormat": "Preferred download/export format when fetch exists (e.g. xml). Empty until used.",
    "checksum": "Optional content hash after last successful fetch/import. Empty until used.",
    "lastImport": "ISO timestamp of last import attempt. Empty until used.",
    "lastSuccess": "ISO timestamp of last successful import. Empty until used.",
    "version": "Feed or mapping version label for migrations. Empty until used.",
    "priority": "Relative import/merge order hint (lower = earlier). Informational only today."
  },
