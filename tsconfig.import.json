{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist/import",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "scripts/import-corendon-xml.ts",
    "scripts/import-all-feeds.ts",
    "scripts/validate-prijsvrij-import.ts",
    "lib/feeds/providers.ts",
    "lib/offers/derive-filter-options.ts",
    "types/travel.ts",
    "lib/feeds/importers/corendon.ts",
    "lib/feeds/importers/prijsvrij.ts",
    "lib/feeds/feed-paths.ts",
    "lib/feeds/canonical/normalize-offer.ts",
    "lib/feeds/canonical/travel-offer.ts",
    "lib/feeds/types/corendon-xml.ts",
    "lib/feeds/types/prijsvrij-xml.ts",
    "lib/feeds/types/stored-offer.ts"
  ]
}
